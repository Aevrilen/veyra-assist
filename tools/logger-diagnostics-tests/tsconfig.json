{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strict": false,
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types"],
    "paths": {
      "@main/*": ["../../src/main/*"],
      "@shared/akari-shard": ["./shard-stub.ts"],
      "@shared/*": ["../../src/shared/*"],
      "electron": ["./electron-stub.d.ts"],
      "winston": ["./node_modules/winston"],
      "winston-transport": ["./node_modules/winston-transport"],
      "axios": ["./node_modules/axios"]
    }
  },
  "include": [
    "../../src/main/logger/index.ts",
    "../../src/main/logger/daily-file-transport.ts",
    "../../src/main/logger/log-flush.ts",
    "../../src/main/logger/automatic-position-diagnostic.ts",
    "../../src/main/shards/logger-factory/automatic-position-feedback.ts",
    "../../src/main/shards/logger-factory/feedback-bundle.ts",
    "../../src/main/shards/logger-factory/feedback-redaction.ts",
    "../../src/main/shards/logger-factory/feedback-zip.ts",
    "../../src/main/shards/logger-factory/feedback-export-controller.ts"
  ]
}
